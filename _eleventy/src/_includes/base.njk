<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Viktor Sauer</title>

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title }} - Viktor Sauer">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:url" content="https://viktorsauer.org{{ page.url }}">
  <meta property="og:image" content="https://viktorsauer.org/images/og-image.jpg">
  <meta property="og:locale" content="de_DE">

  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}

  <link rel="stylesheet" href="/css/style.css">
  {% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  {% include "sandwich.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <script src="/js/main.js"></script>
</body>
</html>
